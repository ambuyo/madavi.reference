---
export const prerender = true;
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Data
import { getSolutions } from "@/lib/sanity/reports";

interface Link {
  text: string;
  href: string;
  description?: string;
}

interface Column {
  category: string;
  href?: string;
  links: Link[];
}

const solutions = await getSolutions();
const solutionLinks: Link[] = solutions.map((solution) => ({
  text: solution.name,
  href: `/solutions/${solution.slug.current}`,
}));
// TapThrive is hardcoded — not managed through Sanity
if (!solutions.some((s) => s.slug.current === "tapthrive")) {
  solutionLinks.push({ text: "TapThrive", href: "/solutions/tapthrive" });
}

const pageSections: { title: string; columns: Column[] }[] = [
  {
    title: "Static",
    columns: [
      {
        category: "Resources",
        links: [
          { text: "HCAIF Framework", description: "5-pillar diagnostic sprint for enterprise AI adoption", href: "/resources/human-centric-ai-integration-framework" },
          { text: "Customer Stories", description: "Behind the successful partnerships", href: "/resources/customer-stories" },
          { text: "Our Clients", description: "Brands we have worked with", href: "/resources/our-clients" },
          { text: "Reports", description: "Data for smarter decisions", href: "/resources/reports" },
          { text: "Blog", description: "Long-form you can learn from", href: "/blog" },
          { text: "FAQs", description: "Answers to common questions", href: "/resources/faqs" },
          { text: "Newsletter", description: "AI strategy insights to your inbox", href: "/resources/newsletter" },
        ],
      },
      {
        category: "Sitemap",
        links: [
          { text: "Blog", href: "/blog" },
          { text: "Industries", href: "/industries" },
          { text: "Our Work", href: "/our-work" },
          { text: "Who We Are", href: "/about" },
        ],
      },
    ],
  },
  {
    title: "Content Collections",
    columns: [
      {
        category: "Solutions",
        href: "https://madavi.co/solutions",
        links: solutionLinks,
      },
      {
        category: "AI Studio",
        href: "https://madavi.co/ai-studio",
        links: [
          { text: "AI Readiness Assessment", href: "/capabilities/ai-readiness" },
          { text: "Executive Advisory", href: "/capabilities/executive-advisory" },
          { text: "Leadership AI Fluency", href: "/capabilities/leadership-cohort" },
          { text: "Keynotes & Licensing", href: "/capabilities/keynotes-licensing" },
          { text: "AI Agent Development", href: "/capabilities/ai-agent-development" },
        ],
      },
      {
        category: "IMC Agency",
        href: "https://madavi.co/the-imc-agency",
        links: [
          { text: "Brand Strategy", href: "/capabilities/brand-strategy" },
          { text: "Brand Communications", href: "/capabilities/brand-communication" },
          { text: "Brand Management", href: "/capabilities/brand-management" },
          { text: "Website Design", href: "/capabilities/website-design" },
          { text: "SEO", href: "/capabilities/seo-services" },
        ],
      },
      {
        category: "Industries",
        href: "https://madavi.co/industries",
        links: [
          { text: "Legal Services", href: "/industries/legal" },
          { text: "Healthcare", href: "/industries/healthcare" },
          { text: "Non Profits", href: "/industries/nonprofits" },
          { text: "Ecommerce & Retail", href: "/industries/retail" },
          { text: "Professional Services", href: "/industries/professional-services" },
          { text: "Real Estate", href: "/industries/real-estate" },
        ],
      },
    ],
  },
];
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-12">
      <Text
        tag="h1"
        variant="displayLG"
        class="text-base-900 text-balance font-medium tracking-tight font-display"
      >
        Overview
      </Text>
      <div class="flex flex-col mt-12 gap-12">
        {
          pageSections.map((section) => (
            <div>
              <Text
                tag="h3"
                variant="displaySM"
                class="font-medium font-display text-base-900"
              >
                {section.title}
              </Text>
              <div class="mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 xl:grid-cols-4">
                {section.columns.map((column) => (
                  <div>
                    {column.href ? (
                      <Text
                        tag="a"
                        variant="textBase"
                        href={column.href}
                        class="font-medium text-base-900 hover:text-base-700 duration-300"
                      >
                        {column.category}
                      </Text>
                    ) : (
                      <Text
                        tag="p"
                        variant="textBase"
                        class="font-medium text-base-900"
                      >
                        {column.category}
                      </Text>
                    )}
                    <ul role="list" class="mt-2 ">
                      {column.links.map((link) => (
                        <li>
                          <Text
                            tag="a"
                            variant="textSM"
                            href={link.href}
                            class="text-base-700 hover:text-base-900 duration-300"
                          >
                            {link.text}
                          </Text>
                          {link.description && (
                            <Text
                              tag="p"
                              variant="textXS"
                              class="text-base-500 mt-0.5"
                            >
                              {link.description}
                            </Text>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
