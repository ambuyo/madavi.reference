---
export const prerender = true;
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
// Our Approach Components
import ApproachHero from "@/components/our-approach/ApproachHero.astro";
import ApproachOld from "@/components/our-approach/ApproachOld.astro";
import HcaifTimeline from "@/components/our-approach/HcaifTimeline.astro";
import HcaifPillars from "@/components/our-approach/hcaifPillars.astro";
import HcaifPillars2 from "@/components/our-approach/hcaifPillars2.astro";
import HcaifPillars3 from "@/components/our-approach/hcaifPillars3.astro";
import HcaifPillars4 from "@/components/our-approach/hcaifPillars4.astro";
import HcaifPillars5 from "@/components/our-approach/hcaifPillars5.astro";

const seo = {
  title: "Our Approach",
  description: "Learn about our approach to AI consulting and digital transformation.",
  type: "website" as const,
};
 
---

<BaseLayout seo={seo}>
  <ApproachHero />
  <ApproachOld />
  <HcaifTimeline />
  <HcaifPillars />
  <HcaifPillars2 />
  <HcaifPillars3 />
  <HcaifPillars4 />
  <HcaifPillars5 />
</BaseLayout>
