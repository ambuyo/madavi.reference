---
const _pageStart = Date.now();
import CategoryLayout from "@/layouts/CategoryLayout.astro";
import { getPostsByCategory, getRecentLivePosts, getCategoryDescription } from "@/lib/data";

export const prerender = false;

const POSTS_PER_PAGE = 20;

const { category: categoryParam } = Astro.params;
if (!categoryParam) {
  console.log(`[page:blog:cat] GET /blog/cat — no category param, redirecting`);
  return Astro.redirect("/blog");
}
console.log(`[page:blog:cat] GET /blog/cat/${categoryParam}`);

// Parse category and page from params
const parts = categoryParam.split('/');
const category = parts[0];
const pageParam = parts[1] ? parseInt(parts[1]) : 1;

// Cached posts for this category, plus live posts merged in
const cachedPosts = await getPostsByCategory(category);
const livePosts = await getRecentLivePosts(30);
const cachedSlugs = new Set(cachedPosts.map(p => p.slug));
const newPosts = livePosts.filter(p =>
  !cachedSlugs.has(p.slug) &&
  p.categories?.some(c => c.slug === category)
);
const categoryPosts = [...newPosts, ...cachedPosts];

// Find category info from any merged source (works even for brand-new categories)
const categoryInfo = cachedPosts[0]?.categories?.find(c => c.slug === category)
  ?? newPosts.flatMap(p => p.categories || []).find(c => c.slug === category);

if (!categoryInfo) {
  console.log(`[page:blog:cat] Category "${category}" not found, redirecting to /blog (${Date.now() - _pageStart}ms)`);
  return Astro.redirect("/blog");
}

// Fetch category description
const categoryDescription = await getCategoryDescription(category);

// Calculate pagination
const totalPages = Math.ceil(categoryPosts.length / POSTS_PER_PAGE);
const currentPage = Math.min(Math.max(pageParam, 1), totalPages) || 1;

if (currentPage !== pageParam) {
  return Astro.redirect(`/blog/cat/${category}${currentPage > 1 ? `/${currentPage}` : ''}`);
}

const startIdx = (currentPage - 1) * POSTS_PER_PAGE;
const paginatedPosts = categoryPosts.slice(startIdx, startIdx + POSTS_PER_PAGE);

const pagination = {
  currentPage,
  totalPages,
  totalPosts: categoryPosts.length,
  hasNextPage: currentPage < totalPages,
  hasPrevPage: currentPage > 1,
  nextPageUrl: currentPage < totalPages ? `/blog/cat/${category}/${currentPage + 1}` : null,
  prevPageUrl: currentPage > 1 ? `/blog/cat/${category}${currentPage - 1 > 1 ? `/${currentPage - 1}` : ''}` : null,
};

console.log(`[page:blog:cat] /blog/cat/${category} — ${paginatedPosts.length} posts, page ${currentPage}/${totalPages} (${Date.now() - _pageStart}ms)`);
---

<CategoryLayout
  category={categoryInfo}
  categoryDescription={categoryDescription}
  posts={paginatedPosts}
  pagination={pagination}
/>
