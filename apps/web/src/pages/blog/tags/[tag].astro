---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import BlogEntry from "@/components/blog/categories/BlogCard1.astro";
// Content
import { getPostsByTag, getRecentLivePosts } from "@/lib/data";

export const prerender = false;
const { tag } = Astro.params;
if (!tag) return Astro.redirect("/blog");

// Cached posts for this tag, plus live posts merged in
const cachedPosts = await getPostsByTag(tag);
const livePosts = await getRecentLivePosts(5);
const cachedSlugs = new Set(cachedPosts.map(p => p.slug));
const newPosts = livePosts.filter(p =>
  !cachedSlugs.has(p.slug) &&
  p.tags?.includes(tag)
);
const posts = [...newPosts, ...cachedPosts];

const seo = {
  title: `Articles tagged "${tag}"`,
  description: `Read articles about ${tag} from Madavi's blog on AI consulting and digital transformation.`,
  type: "website" as const,
};
---

<BaseLayout seo={seo}>
  <section>
    <Wrapper variant="standard" class="py-12">
      <div class="max-w-2xl">
        <Kicker variant="default">Tag category</Kicker>
        <Text
          tag="h1"
          variant="displayLG"
          class="text-base-900 text-balance font-medium tracking-tight mt-8 font-display capitalize"
        >
          {tag.replace(/-/g, " ")}
        </Text>
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-2 mt-12 gap-2 p-8 lg:p-12 bg-base-50"
      >
        {
          posts.map((post, index) => (
            <BlogEntry post={post} index={index + 1} />
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
