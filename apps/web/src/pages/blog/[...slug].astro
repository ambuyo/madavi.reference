---
export const prerender = false;
import SingleBlogLayout from "@/layouts/SingleBlogLayout.astro";
import { getPostBySlug, getPostBySlugLive } from "@/lib/data";

const { slug } = Astro.params;
const slugStr = Array.isArray(slug) ? slug[slug.length - 1] : slug;

// Try cache first, then live WP for new posts
const cached = await getPostBySlug(slugStr!);
// Cache files are flat (top-level title/date/image/seo/body); the layouts
// expect the Post shape with a `data` wrapper — normalize here.
const post = cached
  ? {
      data: cached as any,
      body: cached.body,
      markdown: cached.markdown,
      plainText: cached.plainText,
    }
  : await getPostBySlugLive(slugStr!);

if (!post) {
  return Astro.redirect("/404");
}

const imageUrl = typeof post.data.image === "string"
  ? post.data.image
  : post.data.image?.url || "";

const categoryName = post.data.categories?.[0]?.name || "Blog";
const categorySlug = post.data.categories?.[0]?.slug;
const wordCount = post.plainText?.trim().split(/\s+/).length || 0;
const readingTimeMinutes = Math.ceil(wordCount / 200);
const readingTime = readingTimeMinutes < 1 ? "1 min" : `${readingTimeMinutes} min`;

const authorName = post.data.team || post.data.author?.name || "Madavi";
const authorAvatar = post.data.author?.avatar;
const authorSlug = post.data.author?.slug;

// Cached posts carry seo.title/seo.description; live posts carry description
// plus optional seo.metaTitle/metaDescription.
const seoTitle = post.data.seo?.title || post.data.seo?.metaTitle || post.data.title;
const seoDescription = post.data.seo?.description || post.data.seo?.metaDescription || post.data.description;
const seoImage = post.data.seo?.ogImage?.asset?.url || imageUrl;

// Cached posts use `date` (string); live posts use `pubDate` (Date)
const publishDate = post.data.pubDate || (post.data.date ? new Date(post.data.date) : new Date());
---

<SingleBlogLayout
  title={post.data.title}
  category={categoryName}
  categorySlug={categorySlug}
  date={publishDate}
  readingTime={readingTime}
  image={imageUrl}
  description={post.data.description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  seoImage={seoImage}
  compiledBy={authorName}
  authorAvatar={authorAvatar}
  authorSlug={authorSlug}
>
  {post.body && <div set:html={post.body} />}
</SingleBlogLayout>
