---
export const prerender = true;
import SingleBlogLayout from "@/layouts/SingleBlogLayout.astro";
import { getPostBySlug } from "@/lib/data";
import { readCachedPosts } from "@/lib/wordpress/cache";

export async function getStaticPaths() {
  try {
    // Use cached posts for static generation to avoid API calls during build
    const cachedPosts = await readCachedPosts();

    if (!cachedPosts || cachedPosts.length === 0) {
      console.warn("No cached posts found. Skipping static path generation.");
      return [];
    }

    return cachedPosts.map((post) => ({
      params: { slug: post.slug },
    }));
  } catch (error) {
    console.error("Error generating static paths:", error);
    return [];
  }
}

const { slug } = Astro.params;
// slug is an array from [...slug], get the last segment which is the post slug
const postSlug = Array.isArray(slug) ? slug[slug.length - 1] : slug;
const post = await getPostBySlug(postSlug!);
if (!post) {
  return Astro.redirect("/404");
}

const imageUrl = post.image?.url || "";

// Extract category name from categories array
const categoryName = post.categories?.[0]?.name || "Blog";

// Calculate reading time
const wordCount = post.plainText?.trim().split(/\s+/).length || 0;
const readingTimeMinutes = Math.ceil(wordCount / 200);
const readingTime = readingTimeMinutes < 1 ? "1 min" : `${readingTimeMinutes} min`;

// Extract author info
const authorName = post.author?.name || "";
---

<SingleBlogLayout
  title={post.title}
  category={categoryName}
  date={post.date ? new Date(post.date) : new Date()}
  readingTime={readingTime}
  image={imageUrl}
  description={post.seo?.description || ""}
  seoTitle={post.title}
  seoDescription={post.seo?.description || ""}
  seoImage={imageUrl}
  compiledBy={authorName}
>
  {post.body && <div set:html={post.body} />}
</SingleBlogLayout>
