---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
// Entries
import BlogCard3 from "@/components/blog/landing/BlogCard3.astro";
// Data — posts are passed in by the parent page; live WP fallback
import type { PostIndexEntry } from "@/lib/data";
import { getPostsByCategoryLive } from "@/lib/data";
let { posts: allPosts } = Astro.props as { posts: PostIndexEntry[] };
if (allPosts.length < 3) {
  const live = await getPostsByCategoryLive("the-ai-studio", 3);
  const slugs = new Set(allPosts.map(p => p.slug));
  allPosts = [...allPosts, ...live.filter(p => !slugs.has(p.slug))];
}
const posts = allPosts;
---

<div>
  <Text tag="h2" variant="textXS" class="text-base-900 uppercase font-medium">
    The AI Studio
  </Text>
  <div
    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-2 relative before:absolute after:absolute before:bg-base-950 after:bg-base-950/10 before:top-0 before:left-0 before:h-px before:w-6 after:top-0 after:right-0 after:left-8 after:h-px pt-4"
  >
    {
      posts.slice(0, 4).map((post) => <BlogCard3 post={post} />)
    }
  </div> 
</div>
