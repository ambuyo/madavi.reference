---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div
      class="grid md:grid-cols-2 lg:grid-cols-3 overflow-hidden"
      style="background-image: url('/Section BG.png'); background-size: cover; background-position: center;"
    >
      <div class="flex flex-col lg:col-span-2 p-8 lg:p-12">
        <div>
          <Text
            tag="h2"
            variant="displayMD"
            class="text-base 950 text-balance font-medium tracking-tight font-display mt-8"
          >
            Pillar 3: Governance Frameworks
          </Text>
        </div>
        <div class="flex flex-col gap-y-4 mt-10">
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              Question to answer
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              How do you safely protect corporate data sovereignty and manage risk?
            </Text>
          </div>
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              Target
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              General Counsel, Chief Risk Officer, and Security Operations.
            </Text>
          </div>
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              Period
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              Days 6–7 (parallel tracking during Technical Audit).
            </Text>
          </div>
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              What It Is
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              The construction of localized, ring-fenced parameters and strict compliance guardrails around data usage. This audit includes vetting external software vendor contracts to insulate your enterprise from predatory vendor lock-in.
            </Text>
          </div>
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              Outcome
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              Absolute psychological and legal safety for the board, guaranteeing 100% ownership of your custom code, model assets, and private intellectual property.
            </Text>
          </div>
        </div>
      </div>
      <div class="self-stretch bg-[#FF5000]"></div>
    </div>
  </Wrapper>
</section>
