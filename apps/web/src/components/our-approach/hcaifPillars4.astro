---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div
      class="grid md:grid-cols-2 lg:grid-cols-3 overflow-hidden"
      style="background-image: url('/Section BG.png'); background-size: cover; background-position: center;"
    >
      <div class="flex flex-col lg:col-span-2 p-8 lg:p-12">
        <div>
          <Text
            tag="h2"
            variant="displayMD"
            class="text-base 950 text-balance font-medium tracking-tight font-display mt-8"
          >
            Pillar 4: Cultural Readiness
          </Text>
        </div>
        <div class="flex flex-col gap-y-4 mt-10">
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              Question to answer
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              Does your workforce actively trust the direction of the automation?
            </Text>
          </div>
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              Target
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              Chief Human Resources Officer, Operations Leads, and Department Managers.
            </Text>
          </div>
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              Period
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              Days 8–11 of the initial Diagnostic Sprint.
            </Text>
          </div>
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              What It Is
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              Qualitative internal readiness audits that measure operational friction points, skill gaps, and underlying "AI anxiety." We design clear change-management communications that position the new technology as an administrative shield.
            </Text>
          </div>
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              Outcome
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              High employee adoption and cultural fluency, shifting internal staff from manual execution roles into high-value Directors of Systems.
            </Text>
          </div>
        </div>
      </div>
      <div class="self-stretch bg-[#FF5000]"></div>
    </div>
  </Wrapper>
</section>
