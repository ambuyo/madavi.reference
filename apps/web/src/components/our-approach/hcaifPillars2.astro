---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div
      class="grid md:grid-cols-2 lg:grid-cols-3 overflow-hidden"
      style="background-image: url('/Section BG.png'); background-size: cover; background-position: center;"
    >
      <div class="flex flex-col lg:col-span-2 p-8 lg:p-12">
        <div>
          <Text
            tag="h2"
            variant="displayMD"
            class="text-base 950 text-balance font-medium tracking-tight font-display mt-8"
          >
            Pillar 2: Technical Readiness
          </Text>
        </div>
        <div class="flex flex-col gap-y-4 mt-10">
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              Question to answer
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              What specific data infrastructure do you actually have to support automation?
            </Text>
          </div>
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              Target
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              Chief Technology Officer, IT Director, and Data Engineering teams.
            </Text>
          </div>
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              Period
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              Days 4–7 of the initial Diagnostic Sprint.
            </Text>
          </div>
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              What It Is
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              A deep architectural audit of your existing data pipelines, API configurations, and software stack stability. We identify hidden "Enterprise Debt" and isolate whether your business terms possess a clean semantic layer before writing code.
            </Text>
          </div>
          <div>
            <Text tag="h3" variant="textBase" class="text-base-900 font-semibold">
              Outcome
            </Text>
            <Text tag="p" variant="textBase" class="text-base-600 mt-1 text-pretty">
              A reality-adjusted technical baseline that isolates exactly where your internal data is clean and ready for secure automation deployment.
            </Text>
          </div>
        </div>
      </div>
      <div class="self-stretch bg-[#FF5000]"></div>
    </div>
  </Wrapper>
</section>
