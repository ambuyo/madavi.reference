---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Check from "@/components/fundations/icons/Check.astro";
const pricingPackages = [
  {
    name: "AI Readiness & Strategy",
    description:
      "For organizations building foundational AI adoption capability before technology deployment",
    price: "From $2.5K",
    period: "",
    additionalPricing: "Assessment & strategy engagements",
    features: [
      "AI readiness diagnostic & maturity benchmarking",
      "Leadership AI fluency cohort (8-week program)",
      "Opportunity mapping & prioritization framework",
      "AI adoption roadmap & governance model",
      "Executive decision brief & board-ready report",
    ],
    isPopular: false,
    buttonText: "Get Started",
    buttonVariant: "default",
  },
  {
    name: "AI Implementation",
    description:
      "For teams ready to build and deploy AI-powered solutions with expert guidance",
    price: "From $5K",
    period: "",
    additionalPricing: "Build & deploy engagements",
    features: [
      "Everything in Readiness & Strategy, plus:",
      "Discovery & technical architecture assessment",
      "Custom AI agent & workflow automation development",
      "Integration with existing systems & data sources",
      "Testing, validation & performance optimization",
      "Dedicated AI engineer & bi-weekly strategy syncs",
    ],
    isPopular: true,
    buttonText: "Get Started",
    buttonVariant: "accent",
  },
  {
    name: "Enterprise Partnership",
    description:
      "For organizations seeking an embedded AI transformation partner at scale",
    price: "Custom",
    period: "",
    additionalPricing: "Tailored retainer & multi-workstream pricing",
    features: [
      "Everything in AI Implementation, plus:",
      "Multi-team, multi-workstream AI program management",
      "Custom AI agent ecosystem design & orchestration",
      "Ongoing training, optimization & expansion support",
      "Embedded fractional AI leadership (CTO/CAIO-as-a-service)",
      "Dedicated account team & priority SLAs",
    ],
    isPopular: false,
    buttonText: "Schedule Consultation",
    buttonVariant: "default",
  },
];
---

<section>
  <Wrapper variant="standard" class="py-12">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-start">
      <Kicker variant="default">Packages</Kicker>
      <Text
        tag="h2"
        variant="displayMD"
        class="text-base-900 text-balance font-medium tracking-tight font-display lg:col-span-2 lg:-mt-2"
      >
        AI Consulting Engagement Models
      </Text>
      <Text
        tag="p"
        variant="textLG"
        class="text-base-900 lg:text-pretty lg:col-span-2"
      >
        Structured engagements designed to meet your organization where it is —
        from exploration to enterprise-scale transformation
      </Text>
    </div>
    <div
      class="grid grid-cols-1 lg:grid-cols-3 gap-4 lg:gap-y-12 mt-12 p-8 lg:p-12 bg-base-50"
    >
      {
        pricingPackages.map((pkg) => (
          <div class="bg-white p-8 relative flex flex-col justiffy-between h-full">
            <div>
              <div>
                <div>
                  <div class="flex items-end justify-between">
                    <div>
                      <Text
                        tag="span"
                        variant="displaySM"
                        class="text-base-900  font-display"
                      >
                        {pkg.price}
                      </Text>
                      <Text tag="span" variant="textSM" class="text-base-700 ">
                        {pkg.period}
                      </Text>
                    </div>
                    {pkg.isPopular && (
                      <span class="bg-white text-accent-500 text-sm font-medium">
                        Most Popular
                      </span>
                    )}
                  </div>
                  <Text tag="p" variant="textXS" class="text-base-500 mt-2">
                    {pkg.additionalPricing}
                  </Text>
                </div>
                <div class="mt-8">
                  <Text
                    tag="h3"
                    variant="textXL"
                    class="text-base-900 font-display"
                  >
                    {pkg.name}
                  </Text>
                  <Text tag="p" variant="textSM" class="text-base-600 ">
                    {pkg.description}
                  </Text>
                </div>
                <Button
                  variant={pkg.buttonVariant}
                  size="sm"
                  isLink={true}
                  href="/get-a-proposal"
                  class="w-full mt-8"
                >
                  {pkg.buttonText}
                </Button>
              </div>
              <ul class="space-y-2 mt-8">
                {pkg.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <Check class="size-4" />
                    <Text tag="span" variant="textSM" class="text-base-600">
                      {feature}
                    </Text>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
