---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Plus from "@/components/fundations/icons/Plus.astro";
// FAQ Data Structure
const faqData = [
  {
    category: "Engagement & Pricing",
    questions: [
      {
        question: "How do you scope an AI consulting engagement?",
        answer:
          "Every engagement begins with a discovery session to understand your organization's current AI maturity, business objectives, and technical landscape. We then propose a scope, timeline, and pricing aligned to your specific context — never a one-size-fits-all package.",
      },
      {
        question: "Can we start small and scale up?",
        answer:
          "Absolutely. Many clients begin with an AI Readiness Diagnostic or a single automation proof-of-concept. As we deliver measurable results, engagements naturally expand. Our models are designed to flex with your needs.",
      },
      {
        question: "What payment terms do you offer?",
        answer:
          "We offer milestone-based payments for project engagements, monthly invoicing for retainers, and upfront pricing for workshops and training cohorts. We'll work with your procurement process to find terms that work.",
      },
      {
        question: "What if we need something not listed here?",
        answer:
          "We build custom engagement models for unique situations — fractional AI leadership, embedded engineering teams, multi-year transformation programs, and more. Reach out and we'll design something that fits your organization.",
      },
    ],
  },
];
---
<section>
  <Wrapper variant="standard" class="py-12">
    <div class="max-w-2xl">
      <Kicker variant="default">Pricing FAQ</Kicker>
      <Text
        tag="h2"
        variant="displayLG"
        class="text-base-900 text-balance font-medium tracking-tight mt-8 font-display"
      >
        Frequently Asked Questions
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="text-base-600 lg:text-balance mt-4"
      >
        Find answers to common questions about our engagement models, pricing
        approach, and how we work with organizations.
      </Text>
    </div>
    <div class="space-y-8 gap-8 mt-12 ">
      {
        faqData.map((category) => (
          <div class="p-8 lg:p-12 bg-base-50">
            <Text
              tag="h3"
              variant="textXL"
              class="text-base-900 text-balance font-medium tracking-tight font-display"
            >
              {category.category}
            </Text>
            <div class="divide-y divide-base-100 border-y border-base-100 mt-2 text-balance">
              {category.questions.map((faq) => (
                <details class="group">
                  <summary class="cursor-pointer py-4 text-base font-medium text-base-900 hover:text-accent-500 transition-colors grid grid-cols-1 lg:grid-cols-2 select-none ">
                    {faq.question}
                    <Plus class="size-5 hidden lg:block transition-transform group-open:rotate-180 duration-300 ml-auto" />
                  </summary>
                  <div class="pb-4  text-base-600">{faq.answer}</div>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
